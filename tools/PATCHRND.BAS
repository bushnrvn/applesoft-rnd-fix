10  REM APPLESOFT RND PATCH - LANGUAGE CARD LOADER
20  REM Requires: PATCH_LC.BIN at $0800, LCLDR.BIN at $0900
30  REM Run from DOS 3.3: RUN PATCHRND
40  PRINT "APPLESOFT RND() PATCH"
50  PRINT "SEEDING FROM MONITOR $4E/$4F"
60  PRINT ""
70  PRINT "LOADING PATCH CODE..."
80  BLOAD "PATCH_LC.BIN",A$800
90  PRINT "LOADING LANGUAGE CARD LOADER..."
100 BLOAD "LCLDR.BIN",A$900
110 PRINT "APPLYING PATCH..."
120 CALL 2304
130 PRINT ""
140 PRINT "DONE. RND() NOW SEEDS FROM $4E/$4F."
150 PRINT "COLD BOOT TO RESET. RE-RUN TO RE-APPLY."
160 PRINT ""
170 PRINT "PRESS ANY KEY TO TEST RND(1)..."
180 GET K$
190 PRINT ""
200 PRINT "RESULT: ";RND(1)
210 PRINT "COLD BOOT AND RE-RUN TO CONFIRM"
220 PRINT "A DIFFERENT VALUE APPEARS."
